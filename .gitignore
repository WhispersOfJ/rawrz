# ============================================================================
# RAWRZ — .gitignore
# ============================================================================
# Union of the three imported repositories' rules (The Bear Cave stack, the
# movie-rpg crate, and cave-deck). The sections below keep each rule's purpose
# so the consolidation is auditable.

# Environment and secrets
.env
.env.local
.env.*.local
secrets/
archive/metacacharr/monitoring/.env

# Service configuration contains databases, credentials, and runtime state.
# The active stack keeps all application config under config/<app>/.
config/*/
config/nzbdav-rclone/cache/
config/nzbdav-rclone/rclone.conf

# Persistent data volumes
data/
logs/

# Backups (generated by scripts/backup.sh; may contain .env copies)
backups/

# Unpackerr download staging
usenet/

# Media symlinks (populated by rclone)
media/movies/*
media/shows/*
media/anime-movies/*
media/anime-shows/*
!media/movies/.gitkeep
!media/shows/.gitkeep
!media/anime-movies/.gitkeep
!media/anime-shows/.gitkeep

# Docker
docker-compose.override.yml

# Ansible (local inventory names your LAN devices)
ansible/hosts.yml
ansible/hosts.ini
ansible/hosts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/

# Build artifacts in preserved archive material
archive/metacacharr/**/bin/
archive/metacacharr/**/obj/
archive/metacacharr/**/*.dll
archive/metacacharr/**/*.pdb
archive/metacacharr/**/*.exe
archive/metacacharr/**/project.assets.json
archive/metacacharr/**/TestResults/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Worktrees must remain inside this repository; their contents are ignored.
.worktrees/

# Freebuff client workspace state (lives inside the repo via the symlink at ~/Projects/The Bear Cave)
.freebuff/
.memsearch/

# db_growth_trend.py runtime sample history (TODO.md #5)
.cache/

# ============================================================================
# Imported components (RAWRZ RPG at backend/rpg, RAWRZ Deck at backend/deck)
# ============================================================================

# Rust build output for both crates (backend/rpg/target,
# backend/deck/backend/target); Cargo.lock stays tracked for applications.
**/target/
*.rs.bk

# Node / frontend build output (backend/deck/frontend)
**/node_modules/
dist/
build/
*.tsbuildinfo

# Imported application runtime state (Deck env backups, scratch SQLite/WAL)
.data/
*.db
*.db-wal
*.db-shm
